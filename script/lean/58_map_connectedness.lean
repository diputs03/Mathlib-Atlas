/-
# 58 — Connectedness of combinatorial maps

Script 56 proved that the Euler characteristic `χ = V - E + F` of every
combinatorial map is even and that an integer genus exists; script 57 proved the
transposition split/join orbit lemma (`±1`). The remaining hypothesis needed for
`χ ≤ 2` (`genus ≥ 0`) is **connectedness**: the darts of one surface component
must be linked, combinatorially, by walking across edges (`τ`) and around vertices
(`σ`).

This file defines connectedness of a rotation system in the natural purely
combinatorial way — transitivity of the permutation group generated by the edge
involution `τ` and the vertex rotation `σ` — and proves, kernel-verified:

1. `faceGroup_eq_vertGroup`: the group generated by `τ` and the face permutation
   `φ = τ * σ⁻¹` is exactly the group generated by `τ` and `σ`. Hence a map is
   connected iff its dual (interchanging vertices and faces) is connected.
2. `connected_iff_reachable`: transitivity is equivalent to an explicit
   `Reachable` relation built from single `τ`/`σ` (and inverse) steps. This is
   the relation on which an edge-insertion / spanning-tree induction for `χ ≤ 2`
   will induct.
3. The two genus-zero seeds of 56 (the one-edge link and loop) are connected.

The inequality `χ ≤ 2` for connected maps is script 59 (it consumes the
`±1` lemma of 57 together with this connectedness characterization). Genus-zero
topological realization remains the one genuinely topological layer beyond both.

No `sorry`, no warnings.
-/

import Mathlib

open Equiv

set_option linter.unusedSectionVars false

namespace SimpleGraph.MapConnected

variable (α : Type*) [Fintype α] [DecidableEq α]

/-- A combinatorial (orientable) map: darts with a fixed-point-free edge
involution `edge` and a vertex rotation `vert`. -/
structure Map where
  /-- Edge involution τ. -/
  edge : Perm α
  /-- τ is an involution. -/
  edge_invol : edge ^ 2 = 1
  /-- τ has no fixed point. -/
  edge_noFix : ∀ x : α, edge x ≠ x
  /-- Vertex rotation σ. -/
  vert : Perm α

/-- Explicit reachability: two darts are connected when one can be reached from
the other by finitely many edge (`τ`) or vertex (`σ`) steps in either direction. -/
inductive Reachable {β : Type*} [DecidableEq β] (M : Map β) : β → β → Prop
  | refl (x : β) : Reachable M x x
  | edgeStep {x y : β} (h : M.edge x = y) : Reachable M x y
  | edgeInvStep {x y : β} (h : M.edge y = x) : Reachable M x y
  | vertStep {x y : β} (h : M.vert x = y) : Reachable M x y
  | vertInvStep {x y : β} (h : M.vert y = x) : Reachable M x y
  | trans {x y z : β} (h1 : Reachable M x y) (h2 : Reachable M y z) :
      Reachable M x z

lemma Reachable.symm {β : Type*} [DecidableEq β] {M : Map β} {x y : β}
    (h : Reachable M x y) : Reachable M y x := by
  induction h with
  | refl x => exact Reachable.refl x
  | edgeStep h => exact Reachable.edgeInvStep h
  | edgeInvStep h => exact Reachable.edgeStep h
  | vertStep h => exact Reachable.vertInvStep h
  | vertInvStep h => exact Reachable.vertStep h
  | trans h1 h2 ih1 ih2 => exact Reachable.trans ih2 ih1

namespace Map

variable (M : Map α)

/-- Face permutation φ = τ · σ⁻¹. -/
def face : Perm α := M.edge * M.vert⁻¹

/-- The vertex group: permutations generated by edge and vertex walks. -/
def vertGroup : Subgroup (Perm α) :=
  Subgroup.closure ({M.edge, M.vert} : Set (Perm α))

/-- The face (dual) group: generated by the edge involution and faces. -/
def faceGroup : Subgroup (Perm α) :=
  Subgroup.closure ({M.edge, M.face} : Set (Perm α))

lemma edge_mem_vertGroup : M.edge ∈ M.vertGroup :=
  Subgroup.subset_closure (by simp)

lemma vert_mem_vertGroup : M.vert ∈ M.vertGroup :=
  Subgroup.subset_closure (by simp)

lemma edge_mem_faceGroup : M.edge ∈ M.faceGroup :=
  Subgroup.subset_closure (by simp)

lemma face_mem_faceGroup : M.face ∈ M.faceGroup :=
  Subgroup.subset_closure (by simp)

/-- σ = φ⁻¹ * τ (using τ² = 1). -/
lemma vert_eq_face_inv_mul_edge : M.vert = M.face⁻¹ * M.edge := by
  rw [face]
  simp [mul_assoc]

/-- The primal and dual permutation groups coincide. -/
theorem faceGroup_eq_vertGroup : M.faceGroup = M.vertGroup := by
  apply le_antisymm
  · have hgen : ({M.edge, M.face} : Set (Perm α)) ⊆ M.vertGroup := by
      intro g hg
      rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
      rcases hg with (rfl | rfl)
      · exact M.edge_mem_vertGroup
      · exact M.vertGroup.mul_mem M.edge_mem_vertGroup
          (M.vertGroup.inv_mem' M.vert_mem_vertGroup)
    have : Subgroup.closure ({M.edge, M.face} : Set (Perm α)) ≤ M.vertGroup := by
      rw [Subgroup.closure_le]; exact hgen
    exact this
  · have hgen : ({M.edge, M.vert} : Set (Perm α)) ⊆ M.faceGroup := by
      intro g hg
      rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
      rcases hg with (rfl | rfl)
      · exact M.edge_mem_faceGroup
      · rw [M.vert_eq_face_inv_mul_edge]
        exact M.faceGroup.mul_mem
          (M.faceGroup.inv_mem' M.face_mem_faceGroup) M.edge_mem_faceGroup
    have : Subgroup.closure ({M.edge, M.vert} : Set (Perm α)) ≤ M.faceGroup := by
      rw [Subgroup.closure_le]; exact hgen
    exact this

private lemma reachable_edge {x y : α} (h : Reachable M x y) :
    Reachable M x (M.edge y) :=
  Reachable.trans h (Reachable.edgeStep rfl)

private lemma reachable_edge_inv {x y : α} (h : Reachable M x y) :
    Reachable M x (M.edge⁻¹ y) :=
  Reachable.trans h (Reachable.edgeInvStep (by simp))

private lemma reachable_vert {x y : α} (h : Reachable M x y) :
    Reachable M x (M.vert y) :=
  Reachable.trans h (Reachable.vertStep rfl)

private lemma reachable_vert_inv {x y : α} (h : Reachable M x y) :
    Reachable M x (M.vert⁻¹ y) :=
  Reachable.trans h (Reachable.vertInvStep (by simp))

/-- A map is connected when its darts form one orbit under the group generated
by `τ` and `σ`. -/
def Connected : Prop :=
  ∀ (x : α), MulAction.orbit M.vertGroup x = Set.univ

lemma connected_iff_forall_orbit :
    M.Connected ↔ ∀ (x y : α), y ∈ MulAction.orbit M.vertGroup x := by
  simp [Connected, Set.eq_univ_iff_forall]

/-- Membership in the generated orbit implies reachability. -/
lemma orbit_subset_reachable (x y : α)
    (h : y ∈ MulAction.orbit M.vertGroup x) : Reachable M x y := by
  obtain ⟨g, rfl⟩ := h
  let S : Subgroup (Perm α) :=
    { carrier := { p |
        (∀ z, Reachable M x z → Reachable M x (p z)) ∧
        (∀ z, Reachable M x z → Reachable M x (p⁻¹ z)) }
      one_mem' := ⟨fun z hz => hz, fun z hz => hz⟩
      mul_mem' := fun {q r} hq hr =>
        And.intro (fun z hz => hq.1 (r z) (hr.1 z hz))
          (fun z hz => hr.2 (q⁻¹ z) (hq.2 z hz))
      inv_mem' := fun {q} hq => And.intro hq.2 hq.1 }
  have hgen : ({M.edge, M.vert} : Set (Perm α)) ⊆ S := by
    intro r hr
    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hr
    rcases hr with (rfl | rfl)
    · exact And.intro (fun z => reachable_edge α M)
          (fun z => reachable_edge_inv α M)
    · exact And.intro (fun z => reachable_vert α M)
          (fun z => reachable_vert_inv α M)
  have hle : M.vertGroup ≤ S := by
    show Subgroup.closure ({M.edge, M.vert} : Set (Perm α)) ≤ S
    rw [Subgroup.closure_le]; exact hgen
  exact (hle g.property).1 x (Reachable.refl x)

private lemma edge_step_orbit {x y : α} (h : M.edge x = y) :
    y ∈ MulAction.orbit M.vertGroup x :=
  ⟨⟨M.edge, M.edge_mem_vertGroup⟩, by simpa using h⟩

private lemma edge_inv_step_orbit {x y : α} (h : M.edge y = x) :
    y ∈ MulAction.orbit M.vertGroup x := by
  have he : M.edge x = y := by
    have h2 : M.edge (M.edge y) = y := by
      rw [← Perm.mul_apply, ← pow_two, M.edge_invol]; simp
    rw [h] at h2
    exact h2
  exact ⟨⟨M.edge, M.edge_mem_vertGroup⟩, by simpa using he⟩

private lemma vert_step_orbit {x y : α} (h : M.vert x = y) :
    y ∈ MulAction.orbit M.vertGroup x :=
  ⟨⟨M.vert, M.vert_mem_vertGroup⟩, by simpa using h⟩

private lemma vert_inv_step_orbit {x y : α} (h : M.vert y = x) :
    y ∈ MulAction.orbit M.vertGroup x := by
  have hv : M.vert⁻¹ x = y := by
    have h9 : M.vert⁻¹ (M.vert y) = y := by simp
    rw [h] at h9
    exact h9
  exact ⟨⟨M.vert⁻¹, M.vertGroup.inv_mem' M.vert_mem_vertGroup⟩, by simpa using hv⟩

private lemma trans_orbit {x y z : α}
    (h1 : y ∈ MulAction.orbit M.vertGroup x)
    (h2 : z ∈ MulAction.orbit M.vertGroup y) :
    z ∈ MulAction.orbit M.vertGroup x := by
  obtain ⟨g, hg⟩ := h1
  obtain ⟨k, hk⟩ := h2
  have hg' : g • x = y := hg
  have hk' : k • y = z := hk
  have key : (k * g : M.vertGroup) • x = z := by
    calc
      (k * g : M.vertGroup) • x = k • (g • x) := smul_smul k g x
      _ = k • y := by rw [hg']
      _ = z := hk'
  exact ⟨k * g, key⟩

/-- Reachability implies membership in the generated orbit. -/
lemma reachable_subset_orbit {x y : α} (h : Reachable M x y) :
    y ∈ MulAction.orbit M.vertGroup x := by
  induction h with
  | refl x => exact MulAction.mem_orbit_self x
  | edgeStep h => exact edge_step_orbit α M h
  | edgeInvStep h => exact edge_inv_step_orbit α M h
  | vertStep h => exact vert_step_orbit α M h
  | vertInvStep h => exact vert_inv_step_orbit α M h
  | trans h1 h2 ih1 ih2 => exact trans_orbit α M ih1 ih2

/-- Connectedness is exactly existence of a finite `τ`/`σ` walk between any two
darts. -/
theorem connected_iff_reachable :
    M.Connected ↔ ∀ (x y : α), Reachable M x y := by
  constructor
  · intro h x y
    have hy : y ∈ MulAction.orbit M.vertGroup x := by
      rw [h x]; trivial
    exact orbit_subset_reachable α M x y hy
  · intro h x
    apply Set.eq_univ_iff_forall.mpr
    intro y
    exact reachable_subset_orbit α M (h x y)

/-- It suffices to check transitivity from one chosen base dart. -/
lemma connected_iff_base (x0 : α) :
    M.Connected ↔ MulAction.orbit M.vertGroup x0 = Set.univ := by
  constructor
  · intro h; exact h x0
  · intro h x
    have hx : x ∈ MulAction.orbit M.vertGroup x0 := by rw [h]; trivial
    obtain ⟨g, hgx⟩ := hx
    apply Set.eq_univ_iff_forall.mpr
    intro y
    have hy : y ∈ MulAction.orbit M.vertGroup x0 := by rw [h]; trivial
    obtain ⟨k, hky⟩ := hy
    have hgx' : g • x0 = x := hgx
    have hky' : k • x0 = y := hky
    have hgoal : (k * g⁻¹ : M.vertGroup) • x = y := by
      rw [hgx'.symm]
      show (k * g⁻¹ : M.vertGroup) • (g • x0) = y
      calc
        (k * g⁻¹ : M.vertGroup) • (g • x0)
          = k • (g⁻¹ • (g • x0)) := smul_smul k g⁻¹ (g • x0)
        _ = k • x0 := by rw [inv_smul_smul]
        _ = y := hky'
    exact ⟨k * g⁻¹, hgoal⟩

end Map

private def s2 : Perm (Fin 2) := swap (0 : Fin 2) 1

/-- The one-edge link of 56. -/
def linkMap : Map (Fin 2) where
  edge := s2
  edge_invol := by simp [s2, pow_two]
  edge_noFix := by intro x; fin_cases x <;> simp [s2]
  vert := 1

/-- The one-edge loop of 56. -/
def loopMap : Map (Fin 2) where
  edge := s2
  edge_invol := by simp [s2, pow_two]
  edge_noFix := by intro x; fin_cases x <;> simp [s2]
  vert := s2

private theorem fin2_reachable_link (x y : Fin 2) : Reachable linkMap x y := by
  fin_cases x <;> fin_cases y
  all_goals first
  | exact Reachable.refl _
  | exact Reachable.edgeStep (by decide)

private theorem fin2_reachable_loop (x y : Fin 2) : Reachable loopMap x y := by
  fin_cases x <;> fin_cases y
  all_goals first
  | exact Reachable.refl _
  | exact Reachable.edgeStep (by decide)

/-- The one-edge link is connected. -/
theorem linkMap_connected : linkMap.Connected :=
  (linkMap.connected_iff_reachable).mpr fin2_reachable_link

/-- The one-edge loop is connected. -/
theorem loopMap_connected : loopMap.Connected :=
  (loopMap.connected_iff_reachable).mpr fin2_reachable_loop

end SimpleGraph.MapConnected
