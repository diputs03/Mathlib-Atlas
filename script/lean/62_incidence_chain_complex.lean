import Mathlib

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

/-!
# Script 62 — Incidence chain complex of a combinatorial map and the algebraic χ ≤ 2 proof

Standalone (digit-prefixed scripts cannot import one another). A combinatorial map
is a finite type of darts with a fixed-point-free edge involution `τ = edge` and a
vertex rotation `σ = vert`; the face permutation is `φ = τ * σ⁻¹`.

This file builds the cellular chain complex over `ℚ`:

  C₂ = ℚ^F →(∂₂) C₁ = ℚ^E →(∂₁) C₀ = ℚ^V

with V/E/F the vertex/edge/face orbit counts, proves `∂₁ * ∂₂ = 0` (face boundary
walks are closed), and uses finite-dimensional rank–nullity to derive

  V − E + F = b₀ − b₁ + b₂.

Connectedness gives `b₀ = 1` (the vertex-incidence left kernel is the constants)
and `b₂ = 1` (face coefficients propagate across edges via `φ * σ = τ`, and the
group generated by τ and φ also contains σ = φ⁻¹ * τ). Hence

  χ = V − E + F = 2 − b₁ ≤ 2

for every connected map — a second, purely linear-algebraic proof of the bound
established combinatorially in script 59, with explicit Betti ranks.
-/

open Equiv Equiv.Perm

namespace SimpleGraph.MapChain

variable {α : Type*} [Fintype α] [DecidableEq α] [LinearOrder α]

/-- Orbit count of a permutation: nontrivial cycles plus fixed points. -/
def orbits (p : Perm α) : Nat :=
  Multiset.card p.cycleType + (Fintype.card α - p.cycleType.sum)

/-- The carrier of the cycle of `f` through `z`; a fixed point is the singleton
`{z}` so every orbit has a nonempty carrier. -/
def cyc (f : Perm α) (z : α) : Finset α :=
  if _h : f z = z then {z} else (f.cycleOf z).support

lemma cyc_mem_self (f : Perm α) (z : α) : z ∈ cyc f z := by
  by_cases h : f z = z
  · rw [cyc, dite_eq_left h]
    simp
  · rw [cyc, dite_eq_right h]
    exact (mem_support_cycleOf_iff' h).mpr SameCycle.rfl

lemma cyc_isCycleOn (f : Perm α) (z : α) : f.IsCycleOn (cyc f z) := by
  by_cases h : f z = z
  · rw [cyc, dite_eq_left h, Finset.coe_singleton]
    exact isCycleOn_singleton.mpr h
  · rw [cyc, dite_eq_right h]
    exact isCycleOn_support_cycleOf f z

lemma mem_cyc_iff (f : Perm α) {z u : α} : u ∈ cyc f z ↔ f.SameCycle z u := by
  by_cases h : f z = z
  · rw [cyc, dite_eq_left h, Finset.mem_singleton]
    constructor
    · rintro rfl
      exact SameCycle.rfl
    · intro hs
      obtain ⟨i, _, hi⟩ := hs.exists_pow_eq'
      have hfix : ∀ i : ℕ, (f ^ i) z = z := by
        intro i
        induction i with
        | zero => rfl
        | succ i ih => rw [pow_succ', Perm.mul_apply, ih, h]
      exact hi ▸ hfix i
  · rw [cyc, dite_eq_right h]
    exact mem_support_cycleOf_iff' h

lemma cyc_eq_iff (f : Perm α) {x y : α} : cyc f x = cyc f y ↔ f.SameCycle x y := by
  constructor
  · intro h
    have hx : x ∈ cyc f y := by
      rw [←h]
      exact cyc_mem_self f x
    exact (mem_cyc_iff f).mp hx |>.symm
  · intro h
    ext z
    constructor
    · intro hz
      exact (mem_cyc_iff f).mpr (h.symm.trans ((mem_cyc_iff f).mp hz))
    · intro hz
      exact (mem_cyc_iff f).mpr (h.trans ((mem_cyc_iff f).mp hz))

lemma cyc_disjoint {f : Perm α} {x y : α} (h : ¬ f.SameCycle x y) :
    Disjoint (cyc f x) (cyc f y) := by
  rw [Finset.disjoint_left]
  intro z hz1 hz2
  have h1 : f.SameCycle x z := (mem_cyc_iff f).mp hz1
  have h2 : f.SameCycle y z := (mem_cyc_iff f).mp hz2
  exact h (h1.trans h2.symm)

/-- A permutation maps each of its cycle carriers onto itself. -/
lemma cyc_image (f : Perm α) (z : α) : Finset.image f (cyc f z) = cyc f z := by
  have hnext : ∀ u, f.SameCycle u (f u) := fun u => ⟨1, by simp⟩
  have hmap : ∀ v ∈ cyc f z, f v ∈ cyc f z := fun v hv =>
    (mem_cyc_iff f).mpr ((mem_cyc_iff f).mp hv |>.trans (hnext v))
  have hsub : Finset.image f (cyc f z) ⊆ cyc f z :=
    Finset.image_subset_iff.mpr hmap
  have hinj : Set.InjOn f (cyc f z) := fun x _ y _ h => f.injective h
  have hcard : (Finset.image f (cyc f z)).card = (cyc f z).card :=
    Finset.card_image_of_injOn hinj
  exact Finset.eq_of_subset_of_card_le hsub (hcard ▸ le_refl _)

/-- The canonical (least) representative of the orbit of `d`. -/
def repOf (p : Perm α) (d : α) : α :=
  (cyc p d).min' ⟨d, cyc_mem_self p d⟩

lemma repOf_mem_cyc (p : Perm α) (d : α) : repOf p d ∈ cyc p d :=
  Finset.min'_mem _ _

lemma repOf_eq_iff (p : Perm α) {d : α} :
    repOf p d = d ↔ d ∈ cyc p d ∧ ∀ y ∈ cyc p d, d ≤ y := by
  exact Finset.min'_eq_iff (cyc p d) _ d

lemma repOf_invar (p : Perm α) (d : α) : repOf p (p d) = repOf p d := by
  have h : p.SameCycle (p d) d := ⟨-1, by simp⟩
  have hs : cyc p (p d) = cyc p d := (cyc_eq_iff p).mpr h
  simp only [repOf, hs]

lemma repOf_invar_inv (p : Perm α) (d : α) : repOf p (p⁻¹ d) = repOf p d := by
  have h : p.SameCycle (p⁻¹ d) d := ⟨1, by simp⟩
  have hs : cyc p (p⁻¹ d) = cyc p d := (cyc_eq_iff p).mpr h
  simp only [repOf, hs]

lemma repOf_idem (p : Perm α) (d : α) : repOf p (repOf p d) = repOf p d := by
  have h : p.SameCycle d (repOf p d) :=
    (mem_cyc_iff p).mp (repOf_mem_cyc p d)
  have hs : cyc p (repOf p d) = cyc p d := (cyc_eq_iff p).mpr h.symm
  have hmin : repOf p d ∈ cyc p (repOf p d) := by
    rw [hs]
    exact repOf_mem_cyc p d
  exact (repOf_eq_iff p).mpr ⟨hmin, fun y hy =>
    Finset.min'_le _ _ (by rw [hs] at hy; exact hy)⟩

/-- The finset of canonical orbit representatives. -/
def reps (p : Perm α) : Finset α :=
  Finset.univ.filter fun d => repOf p d = d

lemma mem_reps_iff (p : Perm α) {d : α} :
    d ∈ reps p ↔ ∀ y ∈ cyc p d, d ≤ y := by
  simp only [reps, Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · intro h
    exact (repOf_eq_iff p).mp h |>.2
  · intro h
    exact (repOf_eq_iff p).mpr ⟨cyc_mem_self p d, h⟩

lemma repOf_mem_reps (p : Perm α) (d : α) : repOf p d ∈ reps p := by
  rw [mem_reps_iff]
  have hcyc : cyc p (repOf p d) = cyc p d :=
    (cyc_eq_iff p).mpr ((mem_cyc_iff p).mp (repOf_mem_cyc p d)).symm
  intro y hy
  rw [hcyc] at hy
  exact Finset.min'_le _ _ hy

lemma reps_eq_image (p : Perm α) :
    reps p = Finset.univ.image (repOf p) := by
  ext d
  rw [mem_reps_iff, Finset.mem_image]
  constructor
  · intro h
    refine ⟨d, Finset.mem_univ d, ?_⟩
    exact (repOf_eq_iff p).mpr ⟨cyc_mem_self p d, h⟩
  · rintro ⟨y, _, rfl⟩
    have hcyc : cyc p (repOf p y) = cyc p y :=
      (cyc_eq_iff p).mpr ((mem_cyc_iff p).mp (repOf_mem_cyc p y)).symm
    intro z hz
    rw [hcyc] at hz
    exact Finset.min'_le _ _ hz

/-- The number of canonical representatives equals the orbit count
(nontrivial cycles plus fixed points). -/
lemma reps_card (p : Perm α) : (reps p).card = orbits p := by
  let nt : Finset α := reps p ∩ p.support
  let fx : Finset α := reps p ∩ (Finset.univ \ p.support)
  have hdis : Disjoint nt fx := by
    rw [Finset.disjoint_left]
    intro x hx1 hx2
    have h1 : x ∈ p.support := (Finset.mem_inter.mp hx1).2
    have h2 : x ∈ Finset.univ \ p.support := (Finset.mem_inter.mp hx2).2
    exact (Finset.mem_sdiff.mp h2).2 h1
  have hunion : nt ∪ fx = reps p := by
    have hdistrib : nt ∪ fx = reps p ∩ (p.support ∪ (Finset.univ \ p.support)) := by
      rw [← Finset.inter_union_distrib_left]
    rw [hdistrib]
    have hcov : p.support ∪ (Finset.univ \ p.support) = Finset.univ :=
      Finset.union_sdiff_of_subset (Finset.subset_univ _)
    rw [hcov, Finset.inter_univ]
  have hfx1 : fx = Finset.univ \ p.support := by
    ext x
    simp only [fx, Finset.mem_inter, Finset.mem_sdiff, Finset.mem_univ, true_and]
    constructor
    · exact And.right
    · intro hx
      have hfix : p x = x := by simpa [Equiv.Perm.mem_support] using hx
      have hc : cyc p x = {x} := by
        rw [cyc, dite_eq_left hfix]
      have hr : repOf p x = x := by
        simp only [repOf, hc]
        simp
      have hrep : x ∈ reps p := by
        simp only [reps, Finset.mem_filter, Finset.mem_univ, true_and, hr]
      exact ⟨hrep, hx⟩
  have hnt_inj : Set.InjOn (fun x : α => p.cycleOf x) nt := by
    intro x hx y hy h
    have hxs : p x ≠ x := Equiv.Perm.mem_support.mp (Finset.mem_inter.mp hx).2
    have hys : p y ≠ y := Equiv.Perm.mem_support.mp (Finset.mem_inter.mp hy).2
    have hxin : x ∈ (p.cycleOf x).support :=
      (mem_support_cycleOf_iff' hxs).mpr SameCycle.rfl
    have heq : p.cycleOf x = p.cycleOf y := h
    rw [heq] at hxin
    have hxy : p.SameCycle x y :=
      ((mem_support_cycleOf_iff' hys).mp hxin).symm
    have hc : cyc p x = cyc p y := (cyc_eq_iff p).mpr hxy
    have hrep : repOf p x = repOf p y := by
      simp only [repOf, hc]
    have hx' : repOf p x = x :=
      (Finset.mem_filter.mp (Finset.mem_inter.mp hx).1).2
    have hy' : repOf p y = y :=
      (Finset.mem_filter.mp (Finset.mem_inter.mp hy).1).2
    exact hx'.symm.trans (hrep.trans hy')
  have hnt_img : Finset.image (fun x : α => p.cycleOf x) nt = p.cycleFactorsFinset := by
    ext c
    rw [Finset.mem_image]
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact cycleOf_mem_cycleFactorsFinset_iff.mpr (Finset.mem_inter.mp hx).2
    · intro hcf
      have hc : c.IsCycle := (mem_cycleFactorsFinset_iff.mp hcf).1
      have hagree : ∀ a ∈ c.support, c a = p a := (mem_cycleFactorsFinset_iff.mp hcf).2
      rcases hc.nonempty_support with ⟨a, ha⟩
      have hca : c = p.cycleOf a := cycle_is_cycleOf ha hcf
      have hna : p a ≠ a := by
        have h : c a ≠ a := Equiv.Perm.mem_support.mp ha
        rw [hagree a ha] at h
        exact h
      let r := repOf p a
      have hrcyc : r ∈ cyc p a := repOf_mem_cyc p a
      have hcsupp : cyc p a = c.support := by
        rw [cyc, dite_eq_right hna, ← hca]
      have hrs : r ∈ c.support := by
        rw [hcsupp] at hrcyc
        exact hrcyc
      have hcr : p.cycleOf r = c := (cycle_is_cycleOf hrs hcf).symm
      have hpr : p r ≠ r := by
        have h : c r ≠ r := Equiv.Perm.mem_support.mp hrs
        rw [hagree r hrs] at h
        exact h
      have hrn : r ∈ p.support := Equiv.Perm.mem_support.mpr hpr
      exact ⟨r, Finset.mem_inter.mpr ⟨repOf_mem_reps p a, hrn⟩, hcr⟩
  have hnt_card : nt.card = Multiset.card p.cycleType := by
    rw [← Finset.card_image_of_injOn hnt_inj, hnt_img, Equiv.Perm.cycleType_def]
    simp
  have hfx_card : fx.card = Fintype.card α - p.cycleType.sum := by
    rw [hfx1]
    have hc : (Finset.univ \ p.support) = (p.support)ᶜ := rfl
    rw [hc, Finset.card_compl, ← p.sum_cycleType]
  have h : (reps p).card = nt.card + fx.card := by
    rw [← hunion, Finset.card_union_of_disjoint hdis]
  rw [h, hnt_card, hfx_card, orbits]

/-- A combinatorial (orientable) map: darts with a fixed-point-free edge
involution `τ = edge` and a vertex rotation `σ = vert`. -/
structure Map (α : Type*) [Fintype α] [DecidableEq α] [LinearOrder α] where
  /-- Edge involution τ. -/
  edge : Perm α
  /-- τ is an involution. -/
  edge_invol : edge ^ 2 = 1
  /-- τ has no fixed point. -/
  edge_noFix : ∀ x : α, edge x ≠ x
  /-- Vertex rotation σ. -/
  vert : Perm α

namespace Map

variable (M : Map α)

/-- Face permutation φ = τ · σ⁻¹. -/
def face : Perm α := M.edge * M.vert⁻¹

/-- φ · σ = τ: the face step followed by the vertex step is the edge step. -/
lemma face_mul_vert : M.face * M.vert = M.edge := by
  rw [face]
  simp [mul_assoc]

/-- τ is its own inverse. -/
lemma edge_inv : M.edge⁻¹ = M.edge := by
  have h : M.edge * M.edge = 1 := by simpa [pow_two] using M.edge_invol
  exact inv_eq_of_mul_eq_one_right h

/-- τ(τ d) = d. -/
lemma edge_edge : ∀ d, M.edge (M.edge d) = d := by
  have h : M.edge ^ 2 = 1 := M.edge_invol
  intro d
  have : (M.edge ^ 2) d = d := by rw [h]; simp
  simpa [pow_two] using this

/-- One dart per edge: the least of the two darts of an edge orbit. -/
def edgeReps : Finset α :=
  Finset.univ.filter fun d => d ≤ M.edge d

lemma mem_edgeReps {d : α} : d ∈ M.edgeReps ↔ d ≤ M.edge d := by
  simp [edgeReps]

lemma edgeReps_disjoint : Disjoint M.edgeReps (Finset.image M.edge M.edgeReps) := by
  rw [Finset.disjoint_left]
  intro x hx hxi
  have hle1 : x ≤ M.edge x := (mem_edgeReps M).mp hx
  rcases Finset.mem_image.mp hxi with ⟨d, hd, rfl⟩
  have hle2 : d ≤ M.edge d := (mem_edgeReps M).mp hd
  have h1 : M.edge d ≤ d := by
    have : M.edge d ≤ M.edge (M.edge d) := hle1
    rwa [M.edge_edge d] at this
  exact M.edge_noFix d (le_antisymm h1 hle2)

/-- τ maps edge representatives bijectively onto the complementary darts. -/
lemma edge_image_edgeReps : Finset.image M.edge M.edgeReps = M.edgeRepsᶜ := by
  ext x
  rw [Finset.mem_image, Finset.mem_compl, mem_edgeReps M]
  constructor
  · rintro ⟨d, hd, rfl⟩
    have hle : d ≤ M.edge d := (mem_edgeReps M).mp hd
    have hne : M.edge d ≠ d := M.edge_noFix d
    intro h2
    have h3 : M.edge d ≤ d := by rwa [M.edge_edge d] at h2
    exact hne (le_antisymm h3 hle)
  · intro h
    have hlt : M.edge x < x := Std.not_le.mp h
    refine ⟨M.edge x, (mem_edgeReps M).mpr ?_, ?_⟩
    · rw [M.edge_edge x]
      exact hlt.le
    · exact M.edge_edge x

/-- `2 · E = #darts`. -/
lemma two_edgeReps_eq_card : 2 * M.edgeReps.card = Fintype.card α := by
  have hinj : Set.InjOn M.edge M.edgeReps := fun x _ y _ h => M.edge.injective h
  have himg : (Finset.image M.edge M.edgeReps).card = M.edgeReps.card :=
    Finset.card_image_of_injOn hinj
  rw [M.edge_image_edgeReps, Finset.card_compl] at himg
  omega

/-- The representative dart of the edge orbit containing `d`. -/
def edgeRepOf (d : α) : α :=
  if d ≤ M.edge d then d else M.edge d

lemma edgeRepOf_mem (d : α) : M.edgeRepOf d ∈ M.edgeReps := by
  rw [mem_edgeReps M]
  by_cases h : d ≤ M.edge d
  · rw [edgeRepOf, ite_eq_left h]
    exact h
  · have hlt : M.edge d < d := Std.not_le.mp h
    rw [edgeRepOf, ite_eq_right h, M.edge_edge d]
    exact hlt.le

lemma edgeRepOf_eq_self_of_mem {d : α} (h : d ∈ M.edgeReps) : M.edgeRepOf d = d := by
  rw [edgeRepOf, ite_eq_left ((mem_edgeReps M).mp h)]

lemma edgeRepOf_invar (d : α) : M.edgeRepOf (M.edge d) = M.edgeRepOf d := by
  by_cases h : d ≤ M.edge d
  · have hne : M.edge d ≠ d := M.edge_noFix d
    have h' : ¬ M.edge d ≤ d := fun h2 => hne (le_antisymm h2 h)
    have hc : ¬ M.edge d ≤ M.edge (M.edge d) := by
      rw [M.edge_edge d]
      exact h'
    rw [edgeRepOf, ite_eq_right hc, edgeRepOf, ite_eq_left h, M.edge_edge d]
  · have hlt : M.edge d < d := Std.not_le.mp h
    have h' : M.edge d ≤ d := hlt.le
    rw [edgeRepOf, ite_eq_left (by rwa [M.edge_edge d]), edgeRepOf, ite_eq_right h]

/-- Vertex index type: canonical σ-orbit representatives. -/
abbrev V : Type _ := {d : α // d ∈ reps M.vert}

/-- Edge index type: canonical edge representatives. -/
abbrev E : Type _ := {d : α // d ∈ M.edgeReps}

/-- Face index type: canonical φ-orbit representatives. -/
abbrev F : Type _ := {d : α // d ∈ reps M.face}

/-- The vertex (σ-orbit representative) of a dart. -/
def vRep (d : α) : M.V :=
  ⟨repOf M.vert d, repOf_mem_reps M.vert d⟩

/-- The face (φ-orbit representative) of a dart. -/
def fRep (d : α) : M.F :=
  ⟨repOf M.face d, repOf_mem_reps M.face d⟩

lemma vRep_invar (d : α) : M.vRep (M.vert d) = M.vRep d :=
  Subtype.ext (repOf_invar M.vert d)

lemma vRep_invar_inv (d : α) : M.vRep (M.vert⁻¹ d) = M.vRep d :=
  Subtype.ext (repOf_invar_inv M.vert d)

lemma fRep_invar (d : α) : M.fRep (M.face d) = M.fRep d :=
  Subtype.ext (repOf_invar M.face d)

lemma fRep_invar_inv (d : α) : M.fRep (M.face⁻¹ d) = M.fRep d :=
  Subtype.ext (repOf_invar_inv M.face d)

lemma V_card : Fintype.card M.V = (reps M.vert).card := by
  rw [Fintype.card_subtype]
  simp [reps]

lemma E_card : Fintype.card M.E = M.edgeReps.card := by
  rw [Fintype.card_subtype]
  simp [edgeReps]

lemma F_card : Fintype.card M.F = (reps M.face).card := by
  rw [Fintype.card_subtype]
  simp [reps]

/-- The vertex group: permutations generated by edge and vertex walks. -/
def vertGroup : Subgroup (Perm α) :=
  Subgroup.closure ({M.edge, M.vert} : Set (Perm α))

/-- A map is connected when its darts form one orbit under the group
generated by τ and σ. -/
def Connected : Prop :=
  ∀ (x y : α), ∃ (g : Perm α), g ∈ M.vertGroup ∧ g x = y

/-- A scalar function on darts invariant under both τ and σ is constant on a
connected map. -/
lemma connected_invariant_constant (hconn : M.Connected) {z : α → ℚ}
    (he : ∀ d, z (M.edge d) = z d) (hv : ∀ d, z (M.vert d) = z d)
    {x y : α} : z x = z y := by
  let S : Subgroup (Perm α) :=
    { carrier := {p | ∀ d, z (p d) = z d}
      one_mem' := fun _ => rfl
      mul_mem' := fun {q r} hq hr d => by
        simpa [Perm.mul_apply] using (hq (r d)).trans (hr d)
      inv_mem' := fun {q} hq d => by
        have := hq (q⁻¹ d)
        simpa using this.symm }
  have heG : M.edge ∈ S := he
  have hvG : M.vert ∈ S := hv
  have hcl : M.vertGroup ≤ S := by
    rw [vertGroup, Subgroup.closure_le]
    intro g hg
    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rcases hg with (rfl | rfl)
    · exact heG
    · exact hvG
  rcases hconn x y with ⟨g, hg, rfl⟩
  exact (hcl hg x).symm

/-- The vertex incidence matrix ∂₁: column `e` is `+1` at the vertex reached by
τ and `-1` at the vertex reached by σ (loops give the zero column). -/
noncomputable def d1 : Matrix M.V M.E ℚ := fun v e =>
  (if v = M.vRep (M.edge e.val) then (1 : ℚ) else 0)
  - (if v = M.vRep e.val then (1 : ℚ) else 0)

lemma d1_transpose_mulVec (y : M.V → ℚ) (e : M.E) :
    M.d1.transpose.mulVec y e =
      y (M.vRep (M.edge e.val)) - y (M.vRep e.val) := by
  set a := M.vRep (M.edge e.val) with ha
  set b := M.vRep e.val with hb
  have hnorm : ∀ (v : M.V), ((if v = a then (1 : ℚ) else 0) * y v) =
      (if v = a then y v else 0) := by
    intro v
    split_ifs <;> simp
  have hnorm2 : ∀ (v : M.V), ((if v = b then (1 : ℚ) else 0) * y v) =
      (if v = b then y v else 0) := by
    intro v
    split_ifs <;> simp
  have hmain : ∑ v : M.V, M.d1 v e * y v = y a - y b := by
    simp only [d1, sub_mul, Finset.sum_sub_distrib]
    rw [Finset.sum_congr rfl (fun v _ => hnorm v),
      Finset.sum_congr rfl (fun v _ => hnorm2 v),
      Finset.sum_ite_eq', Finset.sum_ite_eq']
    all_goals simp
  simpa [Matrix.mulVec, dotProduct, Matrix.transpose_apply] using hmain

/-- The edge met at corner `c`: the corner sits at dart `a = σ⁻¹ c` and is
incident with the edge orbit of `a`. -/
def occEdge (c : α) : M.E :=
  ⟨M.edgeRepOf (M.vert⁻¹ c), M.edgeRepOf_mem (M.vert⁻¹ c)⟩

/-- Orientation sign of the corner incidence: `+1` if `a ≤ τ a`, `-1` otherwise. -/
def occSign (c : α) : ℚ :=
  if M.vert⁻¹ c ≤ M.edge (M.vert⁻¹ c) then 1 else -1

/-- At a corner, the signed ∂₁ column of its edge is the difference of the
destination and source vertex indicators; summing these around a face orbit
telescopes to zero. -/
lemma corner_column (c : α) (v : M.V) :
    M.occSign c * M.d1 v (M.occEdge c) =
      (if v = M.vRep (M.face c) then (1 : ℚ) else 0)
      - (if v = M.vRep c then (1 : ℚ) else 0) := by
  set a := M.vert⁻¹ c with ha_def
  have hc : c = M.vert a := by simp [ha_def]
  have hface : M.face c = M.edge a := by
    rw [face, hc]
    simp [Perm.mul_apply]
  have hv : M.vRep c = M.vRep a := by
    rw [hc, M.vRep_invar a]
  by_cases h : a ≤ M.edge a
  · have hs : M.occSign c = 1 := by
      rw [occSign, ←ha_def, ite_eq_left h]
    have he : M.occEdge c = ⟨a, (mem_edgeReps M).mpr h⟩ := by
      rw [occEdge]
      apply Subtype.ext
      simp only [←ha_def, edgeRepOf, ite_eq_left h]
    rw [hs, he, hface, hv]
    simp [d1]
  · have hlt : M.edge a < a := Std.not_le.mp h
    have hb : M.edge a ∈ M.edgeReps := (mem_edgeReps M).mpr (by
      rw [M.edge_edge a]
      exact hlt.le)
    have hs : M.occSign c = -1 := by
      rw [occSign, ←ha_def, ite_eq_right h]
    have he : M.occEdge c = ⟨M.edge a, hb⟩ := by
      rw [occEdge]
      apply Subtype.ext
      simp only [←ha_def, edgeRepOf, ite_eq_right h]
    rw [hs, he, hface, hv]
    simp [d1, M.edge_edge a]

/-- The face incidence matrix ∂₂: column `f` records the signed edge corners
around face `f`. -/
noncomputable def d2 : Matrix M.E M.F ℚ := fun e f =>
  ∑ c ∈ cyc M.face f.val,
    (if e = M.occEdge c then M.occSign c else (0 : ℚ))

/-- Face boundary walks are closed: `∂₁ * ∂₂ = 0`. -/
lemma d1_mul_d2 : M.d1 * M.d2 = 0 := by
  ext v f
  simp only [Matrix.mul_apply, d2, Matrix.zero_apply]
  rw [Finset.sum_congr rfl (fun e _ => by rw [Finset.mul_sum]),
    Finset.sum_comm]
  have hsel : ∀ c ∈ cyc M.face f.val,
      ∑ e : M.E, M.d1 v e * (if e = M.occEdge c then M.occSign c else 0) =
        M.occSign c * M.d1 v (M.occEdge c) := by
    intro c _
    rw [Finset.sum_eq_single_of_mem (M.occEdge c) (Finset.mem_univ _)]
    · simp
      ring
    · intro e _ hne
      rw [ite_eq_right hne, mul_zero]
  rw [Finset.sum_congr rfl hsel]
  rw [Finset.sum_congr rfl (fun c _ => M.corner_column c v)]
  rw [Finset.sum_sub_distrib]
  have hi : Set.InjOn M.face (cyc M.face f.val) :=
    fun x _ y _ h => M.face.injective h
  have himg : ∑ c ∈ cyc M.face f.val,
      (if v = M.vRep (M.face c) then (1 : ℚ) else 0) =
      ∑ c ∈ cyc M.face f.val, (if v = M.vRep c then (1 : ℚ) else 0) := by
    have h0 : ∑ y ∈ Finset.image M.face (cyc M.face f.val),
        (if v = M.vRep y then (1 : ℚ) else 0) =
        ∑ c ∈ cyc M.face f.val,
          (if v = M.vRep (M.face c) then (1 : ℚ) else 0) :=
      Finset.sum_image hi
    have h1 : Finset.image M.face (cyc M.face f.val) = cyc M.face f.val :=
      cyc_image M.face f.val
    rw [h1] at h0
    exact h0.symm
  exact sub_eq_zero.mpr himg

/-- Rank r₁ of ∂₁. -/
noncomputable def r1 : ℕ := M.d1.rank

/-- Rank r₂ of ∂₂. -/
noncomputable def r2 : ℕ := M.d2.rank

/-- The range of ∂₂ lies in the kernel of ∂₁. -/
lemma range_d2_le_ker_d1 :
    M.d2.mulVecLin.range ≤ M.d1.mulVecLin.ker := by
  intro z hz
  rcases hz with ⟨x, rfl⟩
  have hzero : (M.d1 * M.d2).mulVec x = 0 := by
    rw [M.d1_mul_d2]
    simp
  have hcomp : M.d1.mulVec (M.d2.mulVec x) = 0 :=
    (Matrix.mulVec_mulVec x M.d1 M.d2).trans hzero
  exact hcomp

/-- `r₁ ≤ |E|`. -/
lemma r1_le_card_E : M.r1 ≤ Fintype.card M.E := by
  have hfn := M.d1.mulVecLin.finrank_range_add_finrank_ker
  have hcard : Module.finrank ℚ (M.E → ℚ) = Fintype.card M.E :=
    Module.finrank_fintype_fun_eq_card ℚ
  have hr1 : Module.finrank ℚ M.d1.mulVecLin.range = M.r1 := rfl
  omega

/-- `r₂ ≤ |E| − r₁`: the rank–nullity consequence of `range ∂₂ ≤ ker ∂₁`. -/
lemma r2_le_nullity1 : M.r2 ≤ Fintype.card M.E - M.r1 := by
  have hfn := M.d1.mulVecLin.finrank_range_add_finrank_ker
  have hcard : Module.finrank ℚ (M.E → ℚ) = Fintype.card M.E :=
    Module.finrank_fintype_fun_eq_card ℚ
  have hr1 : Module.finrank ℚ M.d1.mulVecLin.range = M.r1 := rfl
  have hr2 : Module.finrank ℚ M.d2.mulVecLin.range = M.r2 := rfl
  have hsub : Module.finrank ℚ M.d2.mulVecLin.range ≤
      Module.finrank ℚ M.d1.mulVecLin.ker :=
    Submodule.finrank_mono M.range_d2_le_ker_d1
  omega

/-- Betti rank b₀ = |V| − r₁. -/
noncomputable def b0 : ℤ := (Fintype.card M.V : ℤ) - M.r1

/-- Betti rank b₁ = |E| − r₁ − r₂. -/
noncomputable def b1 : ℤ := (Fintype.card M.E : ℤ) - M.r1 - M.r2

/-- Betti rank b₂ = |F| − r₂. -/
noncomputable def b2 : ℤ := (Fintype.card M.F : ℤ) - M.r2

lemma b1_nonneg : 0 ≤ M.b1 := by
  rw [b1, ← Int.ofNat_sub M.r1_le_card_E]
  exact sub_nonneg.mpr (Int.ofNat_le.mpr M.r2_le_nullity1)

/-- The Euler characteristic equals the alternating sum of Betti ranks. -/
lemma euler_betti :
    (Fintype.card M.V : ℤ) - Fintype.card M.E + Fintype.card M.F =
      M.b0 - M.b1 + M.b2 := by
  simp [b0, b1, b2]
  ring

section Connected

variable [Nonempty α]

/-- A face representative labels every corner in its carrier. -/
lemma fRep_of_carrier (M : Map α) {f : M.F} {c : α}
    (hc : c ∈ cyc M.face f.val) : M.fRep c = f := by
  have hs : M.face.SameCycle f.val c := (mem_cyc_iff M.face).mp hc
  have hcyc : cyc M.face c = cyc M.face f.val :=
    (cyc_eq_iff M.face).mpr hs.symm
  have hfp : repOf M.face f.val = f.val := by
    have hp : f.val ∈ reps M.face := f.property
    simp only [reps, Finset.mem_filter, Finset.mem_univ, true_and] at hp
    exact hp
  apply Subtype.ext
  simpa [fRep, repOf, hcyc] using hfp

/-- Face carriers are pairwise disjoint. -/
lemma face_carriers_pairwise (M : Map α) :
    Set.PairwiseDisjoint (↑(Finset.univ : Finset M.F))
      (fun f : M.F => cyc M.face f.val) := by
  intro f _ g _ hne
  apply Finset.disjoint_left.mpr
  intro c hc1 hc2
  have h1 : M.face.SameCycle f.val c := (mem_cyc_iff M.face).mp hc1
  have h2 : M.face.SameCycle g.val c := (mem_cyc_iff M.face).mp hc2
  have hfg : M.face.SameCycle f.val g.val := h1.trans h2.symm
  have hc : cyc M.face f.val = cyc M.face g.val :=
    (cyc_eq_iff M.face).mpr hfg
  have hfp : repOf M.face f.val = f.val := by
    have hp : f.val ∈ reps M.face := f.property
    simp only [reps, Finset.mem_filter, Finset.mem_univ, true_and] at hp
    exact hp
  have hgp : repOf M.face g.val = g.val := by
    have hp : g.val ∈ reps M.face := g.property
    simp only [reps, Finset.mem_filter, Finset.mem_univ, true_and] at hp
    exact hp
  have heq : repOf M.face f.val = repOf M.face g.val := by
    simp only [repOf, hc]
  have hvg : f.val = g.val := by
    rw [hfp, hgp] at heq
    exact heq
  exact hne (Subtype.ext hvg)

/-- Face carriers cover every dart. -/
lemma face_carriers_cover (M : Map α) :
    Finset.biUnion (Finset.univ : Finset M.F) (fun f => cyc M.face f.val) =
      Finset.univ := by
  ext c
  simp only [Finset.mem_univ, iff_true]
  rw [Finset.mem_biUnion]
  refine ⟨M.fRep c, Finset.mem_univ _, ?_⟩
  have hrc : repOf M.face c ∈ cyc M.face c := repOf_mem_cyc M.face c
  have hsame : cyc M.face (repOf M.face c) = cyc M.face c :=
    (cyc_eq_iff M.face).mpr ((mem_cyc_iff M.face).mp hrc).symm
  have hgoal : c ∈ cyc M.face (repOf M.face c) := by
    rw [hsame]
    exact cyc_mem_self M.face c
  simpa [fRep] using hgoal

/-- Sums over the face carriers partition sums over all darts. -/
lemma face_sum_univ (M : Map α) (q : α → ℚ) :
    ∑ f : M.F, ∑ c ∈ cyc M.face f.val, q c =
      ∑ c ∈ (Finset.univ : Finset α), q c := by
  rw [← Finset.sum_biUnion M.face_carriers_pairwise, M.face_carriers_cover]

/-- `edgeRepOf d` is the representative `e` exactly when `d` is one of the two
darts of the edge orbit of `e`. -/
lemma edgeRepOf_eq_iff (M : Map α) {d : α} {e : M.E} :
    M.edgeRepOf d = e.val ↔ d = e.val ∨ d = M.edge e.val := by
  constructor
  · intro h
    by_cases hle : d ≤ M.edge d
    · rw [edgeRepOf, ite_eq_left hle] at h
      exact Or.inl h
    · rw [edgeRepOf, ite_eq_right hle] at h
      have h10 : d = M.edge e.val := by
        have := congr_arg M.edge h
        rwa [M.edge_edge d] at this
      exact Or.inr h10
  · rintro (rfl | rfl)
    · exact M.edgeRepOf_eq_self_of_mem e.property
    · rw [M.edgeRepOf_invar, M.edgeRepOf_eq_self_of_mem e.property]

/-- An edge has exactly two corners: `σ e` with sign `+1` and `σ(τ e)` with
sign `-1`. -/
lemma occEdge_eq_iff (M : Map α) {c : α} {e : M.E} :
    M.occEdge c = e ↔
      c = M.vert e.val ∨ c = M.vert (M.edge e.val) := by
  have h1 : M.occEdge c = e ↔ M.edgeRepOf (M.vert⁻¹ c) = e.val := by
    simp [occEdge, Subtype.ext_iff]
  rw [h1, M.edgeRepOf_eq_iff]
  constructor
  · rintro (h | h)
    · left
      have h9 : M.vert (M.vert⁻¹ c) = c := by simp
      exact h9.symm.trans (congr_arg M.vert h)
    · right
      have h9 : M.vert (M.vert⁻¹ c) = c := by simp
      exact h9.symm.trans (congr_arg M.vert h)
  · rintro (h | h)
    · rw [h]
      simp
    · rw [h]
      simp

/-- The corner `σ e` has sign `+1`. -/
lemma occSign_vert_edgeRep (M : Map α) (e : M.E) :
    M.occSign (M.vert e.val) = 1 := by
  rw [occSign]
  have h : M.vert⁻¹ (M.vert e.val) = e.val := by simp
  rw [h, ite_eq_left ((mem_edgeReps M).mp e.property)]

/-- The corner `σ(τ e)` has sign `-1`. -/
lemma occSign_vert_edge (M : Map α) (e : M.E) :
    M.occSign (M.vert (M.edge e.val)) = -1 := by
  rw [occSign]
  have h : M.vert⁻¹ (M.vert (M.edge e.val)) = M.edge e.val := by simp
  rw [h, M.edge_edge e.val]
  have hne : ¬ M.edge e.val ≤ e.val := by
    intro hle
    have heq : M.edge e.val = e.val :=
      le_antisymm hle ((mem_edgeReps M).mp e.property)
    exact M.edge_noFix e.val heq
  exact ite_eq_right hne

/-- The two corners of an edge are distinct. -/
lemma corner_ne (M : Map α) (e : M.E) :
    M.vert e.val ≠ M.vert (M.edge e.val) := by
  intro h
  have : e.val = M.edge e.val := M.vert.injective h
  exact M.edge_noFix e.val this.symm

/-- Over all darts, the signed corners of an edge reduce to the difference of
its two endpoint vertex values. -/
lemma sum_occEdge (M : Map α) (z : α → ℚ) (e : M.E) :
    ∑ c ∈ (Finset.univ : Finset α),
      (if e = M.occEdge c then M.occSign c * z c else (0 : ℚ)) =
      z (M.vert e.val) - z (M.vert (M.edge e.val)) := by
  let c1 := M.vert e.val
  let c2 := M.vert (M.edge e.val)
  have hfilter : (Finset.univ : Finset α).filter (fun c => e = M.occEdge c) =
      {c1, c2} := by
    ext c
    simp only [c1, c2, Finset.mem_filter, Finset.mem_univ, true_and,
      Finset.mem_insert, Finset.mem_singleton]
    rw [eq_comm, M.occEdge_eq_iff]
  have hmain : ∑ c ∈ (Finset.univ : Finset α),
      (if e = M.occEdge c then M.occSign c * z c else (0 : ℚ)) =
      ∑ c ∈ (Finset.univ : Finset α).filter (fun c => e = M.occEdge c),
        M.occSign c * z c := by
    rw [← Finset.sum_filter]
  rw [hmain, hfilter, Finset.sum_pair (M.corner_ne e),
    M.occSign_vert_edgeRep e, M.occSign_vert_edge e]
  ring

/-- A ∂₂ column product, expanded over all darts via the face partition. -/
lemma d2_mulVec_as_sum (M : Map α) (x : M.F → ℚ) (e : M.E) :
    M.d2.mulVec x e = ∑ c ∈ (Finset.univ : Finset α),
      (if e = M.occEdge c then M.occSign c * x (M.fRep c) else (0 : ℚ)) := by
  let q : α → ℚ := fun c =>
    (if e = M.occEdge c then M.occSign c * x (M.fRep c) else 0)
  simp only [d2, Matrix.mulVec, dotProduct]
  have hstep : ∑ i : M.F, (∑ c ∈ cyc M.face i.val,
        (if e = M.occEdge c then M.occSign c else 0)) * x i =
      ∑ i : M.F, ∑ c ∈ cyc M.face i.val,
        (if e = M.occEdge c then M.occSign c * x i else 0) := by
    apply Finset.sum_congr rfl
    intro i _
    rw [Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro c _
    split_ifs <;> ring
  rw [hstep]
  have hstep2 : ∑ i : M.F, ∑ c ∈ cyc M.face i.val,
        (if e = M.occEdge c then M.occSign c * x i else 0) =
      ∑ i : M.F, ∑ c ∈ cyc M.face i.val, q c := by
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro c hc
    have hcf : M.fRep c = i := M.fRep_of_carrier hc
    by_cases h : e = M.occEdge c
    · simp only [q, ite_eq_left h, hcf]
    · simp only [q, ite_eq_right h]
  rw [hstep2, M.face_sum_univ q]

private lemma constants_le_ker_d1_transpose (M : Map α) :
    Submodule.span ℚ ({1} : Set (M.V → ℚ)) ≤ M.d1.transpose.mulVecLin.ker := by
  rw [Submodule.span_le]
  intro f hf
  have h1 : f = (1 : M.V → ℚ) := by simpa using hf
  rw [h1]
  have hz : M.d1.transpose.mulVec (1 : M.V → ℚ) = 0 := by
    ext e
    simp [M.d1_transpose_mulVec]
  exact hz

private lemma ker_d1_transpose_le_constants (M : Map α) (hconn : M.Connected) :
    M.d1.transpose.mulVecLin.ker ≤ Submodule.span ℚ ({1} : Set (M.V → ℚ)) := by
  intro y hy
  have hk : ∀ (e : M.E), M.d1.transpose.mulVec y e = 0 := by
    intro e
    exact congr_fun hy e
  let z : α → ℚ := fun d => y (M.vRep d)
  have he1 : ∀ (e : M.E), z (M.edge e.val) = z e.val := by
    intro e
    have h := sub_eq_zero.mp (M.d1_transpose_mulVec y e ▸ hk e)
    simpa [z] using h
  have he : ∀ d, z (M.edge d) = z d := by
    intro d
    by_cases h : d ∈ M.edgeReps
    · exact he1 ⟨d, h⟩
    · have hd : d ∈ (M.edgeRepsᶜ) := by simpa using h
      rw [← M.edge_image_edgeReps] at hd
      rcases Finset.mem_image.mp hd with ⟨e, he, rfl⟩
      simpa [M.edge_edge e] using (he1 ⟨e, he⟩).symm
  have hv : ∀ d, z (M.vert d) = z d := by
    intro d
    show y (M.vRep (M.vert d)) = y (M.vRep d)
    rw [M.vRep_invar d]
  obtain ⟨d0⟩ : Nonempty α := inferInstance
  let k : ℚ := z d0
  have hconst : ∀ d, z d = k := fun d =>
    M.connected_invariant_constant hconn he hv
  have hrep : ∀ (v : M.V), M.vRep v.val = v := by
    intro v
    apply Subtype.ext
    have hp : v.val ∈ reps M.vert := v.property
    have h : repOf M.vert v.val = v.val := by
      simp only [reps, Finset.mem_filter, Finset.mem_univ, true_and] at hp
      exact hp
    exact h
  have hyk : y = fun _ => k := by
    ext v
    have : y v = z v.val := by
      dsimp only [z]
      rw [hrep v]
    rw [this, hconst v.val]
  rw [hyk]
  exact Submodule.mem_span_singleton.mpr ⟨k, by ext i; simp⟩

/-- For a connected map, `ker ∂₁ᵀ` is exactly the constant vertex functions. -/
lemma ker_d1_transpose_eq_span (M : Map α) (hconn : M.Connected) :
    M.d1.transpose.mulVecLin.ker = Submodule.span ℚ ({1} : Set (M.V → ℚ)) :=
  le_antisymm (M.ker_d1_transpose_le_constants hconn)
    (M.constants_le_ker_d1_transpose)

/-- The constant vertex functions form a one-dimensional space. -/
lemma finrank_ker_d1_transpose (M : Map α) (hconn : M.Connected) :
    Module.finrank ℚ M.d1.transpose.mulVecLin.ker = 1 := by
  rw [M.ker_d1_transpose_eq_span hconn]
  obtain ⟨d⟩ : Nonempty α := inferInstance
  have hne : (1 : M.V → ℚ) ≠ 0 := by
    intro h
    have := congr_fun h (M.vRep d)
    simp at this
  exact finrank_span_singleton hne

/-- `r₁ = |V| − 1` for a connected map. -/
lemma r1_eq_card_V_sub_one (M : Map α) (hconn : M.Connected) :
    M.r1 = Fintype.card M.V - 1 := by
  have hfn := M.d1.transpose.mulVecLin.finrank_range_add_finrank_ker
  have hcard : Module.finrank ℚ (M.V → ℚ) = Fintype.card M.V :=
    Module.finrank_fintype_fun_eq_card ℚ
  have hk := M.finrank_ker_d1_transpose hconn
  have hr : Module.finrank ℚ M.d1.transpose.mulVecLin.range = M.r1 := by
    have hr0 : Module.finrank ℚ M.d1.transpose.mulVecLin.range =
        M.d1.transpose.rank := rfl
    rw [hr0, Matrix.rank_transpose]
    rfl
  omega

/-- Connected maps have `b₀ = 1`. -/
lemma b0_eq_one (M : Map α) (hconn : M.Connected) : M.b0 = 1 := by
  obtain ⟨d⟩ : Nonempty α := inferInstance
  have hV1 : 1 ≤ Fintype.card M.V :=
    Fintype.card_pos_iff.mpr ⟨M.vRep d⟩
  rw [b0, M.r1_eq_card_V_sub_one hconn, Int.ofNat_sub hV1]
  ring

/-- Constant face chains are killed by ∂₂: the two corners of every edge carry
opposite signs. -/
private lemma constants_le_ker_d2 (M : Map α) :
    Submodule.span ℚ ({1} : Set (M.F → ℚ)) ≤ M.d2.mulVecLin.ker := by
  rw [Submodule.span_le]
  intro f hf
  have h1 : f = (1 : M.F → ℚ) := by simpa using hf
  rw [h1]
  have hz : ∀ e : M.E, M.d2.mulVec (1 : M.F → ℚ) e = 0 := by
    intro e
    rw [M.d2_mulVec_as_sum (1 : M.F → ℚ) e]
    simpa using M.sum_occEdge (fun _ => (1 : ℚ)) e
  exact funext hz

/-- For a connected map, every face chain killed by ∂₂ is constant. Face
invariance propagates through corners: ∂₂-closedness forces equality across
each edge, the conjugated edge relation propagates to all darts, and
connectedness then forces a single value. -/
private lemma ker_d2_le_constants (M : Map α) (hconn : M.Connected) :
    M.d2.mulVecLin.ker ≤ Submodule.span ℚ ({1} : Set (M.F → ℚ)) := by
  intro x hx
  have hk : ∀ e : M.E, M.d2.mulVec x e = 0 := fun e => congr_fun hx e
  let z : α → ℚ := fun d => x (M.fRep d)
  have hzface : ∀ d, z (M.face d) = z d := by
    intro d
    show x (M.fRep (M.face d)) = x (M.fRep d)
    rw [M.fRep_invar d]
  have hzfaceinv : ∀ d, z (M.face⁻¹ d) = z d := by
    intro d
    have h := hzface (M.face⁻¹ d)
    simp at h
    exact h.symm
  have hrel : ∀ (e : M.E), z (M.vert e.val) = z (M.vert (M.edge e.val)) := by
    intro e
    have h := hk e
    rw [M.d2_mulVec_as_sum x e, M.sum_occEdge z e] at h
    exact sub_eq_zero.mp h
  let tau' : α → α := fun d => M.vert (M.edge (M.vert⁻¹ d))
  have htau' : ∀ d, z (tau' d) = z d := by
    intro d
    let e0 : M.E :=
      ⟨M.edgeRepOf (M.vert⁻¹ d), M.edgeRepOf_mem (M.vert⁻¹ d)⟩
    have hcases :
        M.vert⁻¹ d = e0.val ∨ M.vert⁻¹ d = M.edge e0.val :=
      (M.edgeRepOf_eq_iff).mp rfl
    rcases hcases with (h1 | h2)
    · have hd : d = M.vert e0.val := by
        have : M.vert (M.vert⁻¹ d) = M.vert e0.val := congr_arg M.vert h1
        simpa using this
      have ht0 : tau' (M.vert e0.val) = M.vert (M.edge e0.val) := by
        simp [tau']
      rw [hd, ht0]
      exact (hrel e0).symm
    · have hd : d = M.vert (M.edge e0.val) := by
        have : M.vert (M.vert⁻¹ d) = M.vert (M.edge e0.val) :=
          congr_arg M.vert h2
        simpa using this
      have h3 : tau' d = M.vert e0.val := by
        rw [hd]
        have ha : M.vert⁻¹ (M.vert (M.edge e0.val)) = M.edge e0.val := by simp
        simp only [tau', ha, M.edge_edge e0.val]
      rw [h3, hd]
      exact hrel e0
  have h4 : ∀ d, M.face (tau' (M.face⁻¹ d)) = M.edge d := by
    intro d
    simp [tau', face, M.edge_inv, M.edge_edge, Perm.mul_apply]
  have ht : ∀ d, z (M.edge d) = z d := by
    intro d
    rw [← h4 d]
    rw [hzface (tau' (M.face⁻¹ d)), htau' (M.face⁻¹ d), hzfaceinv d]
  have hsigma : M.vert = M.face⁻¹ * M.edge := by
    calc M.vert
        = M.face⁻¹ * (M.face * M.vert) := by simp
      _ = M.face⁻¹ * M.edge := by rw [M.face_mul_vert]
  have hv : ∀ d, z (M.vert d) = z d := by
    intro d
    have h5 : M.vert d = M.face⁻¹ (M.edge d) := by
      rw [hsigma]
      rfl
    rw [h5, hzfaceinv (M.edge d), ht d]
  obtain ⟨d0⟩ : Nonempty α := inferInstance
  let k : ℚ := z d0
  have hconst : ∀ d, z d = k := fun d =>
    M.connected_invariant_constant hconn ht hv
  have hxf : ∀ (f : M.F), x f = k := by
    intro f
    have hff : M.fRep f.val = f := by
      apply Subtype.ext
      have hp : f.val ∈ reps M.face := f.property
      have hr : repOf M.face f.val = f.val := by
        simp only [reps, Finset.mem_filter, Finset.mem_univ, true_and] at hp
        exact hp
      simpa [fRep] using hr
    have : x f = z f.val := by
      dsimp only [z]
      rw [hff]
    rw [this, hconst f.val]
  have hyk : x = fun _ => k := by ext f; exact hxf f
  rw [hyk]
  exact Submodule.mem_span_singleton.mpr ⟨k, by ext i; simp⟩

/-- For a connected map, `ker ∂₂` is exactly the one-dimensional space of
constant face chains. -/
lemma ker_d2_eq_span (M : Map α) (hconn : M.Connected) :
    M.d2.mulVecLin.ker = Submodule.span ℚ ({1} : Set (M.F → ℚ)) :=
  le_antisymm (M.ker_d2_le_constants hconn) M.constants_le_ker_d2

/-- `finrank ker ∂₂ = 1` for a connected map. -/
lemma finrank_ker_d2 (M : Map α) (hconn : M.Connected) :
    Module.finrank ℚ M.d2.mulVecLin.ker = 1 := by
  obtain ⟨d⟩ : Nonempty α := inferInstance
  have hne : (1 : M.F → ℚ) ≠ 0 := by
    intro h
    have hz : (1 : ℚ) = 0 := congr_fun h (M.fRep d)
    simp at hz
  rw [M.ker_d2_eq_span hconn, finrank_span_singleton hne]

/-- `rank ∂₂ = |F| − 1` for a connected map. -/
lemma r2_eq_card_F_sub_one (M : Map α) (hconn : M.Connected) :
    M.r2 = Fintype.card M.F - 1 := by
  have hfn := M.d2.mulVecLin.finrank_range_add_finrank_ker
  have hcard : Module.finrank ℚ (M.F → ℚ) = Fintype.card M.F :=
    Module.finrank_fintype_fun_eq_card ℚ
  have hr2 : Module.finrank ℚ M.d2.mulVecLin.range = M.r2 := rfl
  rw [M.finrank_ker_d2 hconn, hcard] at hfn
  omega

/-- Connected maps have `b₂ = 1`: the sphere has one 2-cycle class. -/
lemma b2_eq_one (M : Map α) (hconn : M.Connected) : M.b2 = 1 := by
  obtain ⟨d⟩ : Nonempty α := inferInstance
  have hF1 : 1 ≤ Fintype.card M.F :=
    Fintype.card_pos_iff.mpr ⟨M.fRep d⟩
  rw [b2, M.r2_eq_card_F_sub_one hconn, Int.ofNat_sub hF1]
  ring

/-- For a connected nonempty map, `χ = 2 − b₁`. -/
lemma euler_betti_connected (M : Map α) (hconn : M.Connected) :
    (Fintype.card M.V : ℤ) - Fintype.card M.E + Fintype.card M.F =
      2 - M.b1 := by
  rw [M.euler_betti, M.b0_eq_one hconn, M.b2_eq_one hconn]
  ring

/-- Connected nonempty maps satisfy `χ ≤ 2`, proved algebraically from the
Betti ranks (`b₁ ≥ 0`). -/
lemma euler_le_two (M : Map α) (hconn : M.Connected) :
    (Fintype.card M.V : ℤ) - Fintype.card M.E + Fintype.card M.F ≤ 2 := by
  rw [M.euler_betti_connected hconn]
  exact sub_le_self _ M.b1_nonneg

end Connected

section Empty

variable [IsEmpty α]

/-- The empty map has `V = E = F = 0`, hence `χ = 0 ≤ 2`. -/
lemma euler_le_two_empty (M : Map α) :
    (Fintype.card M.V : ℤ) - Fintype.card M.E + Fintype.card M.F ≤ 2 := by
  have hV : Fintype.card M.V = 0 :=
    Fintype.card_eq_zero_iff.mpr (by infer_instance)
  have hE : Fintype.card M.E = 0 :=
    Fintype.card_eq_zero_iff.mpr (by infer_instance)
  have hF : Fintype.card M.F = 0 :=
    Fintype.card_eq_zero_iff.mpr (by infer_instance)
  rw [hV, hE, hF]
  norm_num

end Empty

end Map

